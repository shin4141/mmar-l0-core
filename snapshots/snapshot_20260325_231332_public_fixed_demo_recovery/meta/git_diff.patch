+                "reason": _first_sentence("Aが最初の基準を維持し、Bはその必要条件を実際には壊せなかった。"),
+            }
+        if residue_owner == "B":
+            return {
+                "side": "A",
+                "reason": _first_sentence("最後に残った未解決条件はB側の責任で、A不利へは倒せない。"),
+            }
+    if side == "A":
+        if drift_from_opening_contract and opening_axis_locked and opening_acceptance_locked:
+            return {
+                "side": "B",
