+                "reason": _first_sentence("Bのフレームが残り、Aは寄生反論だけでは必要条件を壊し切れなかった。"),
+            }
+        if structural_signal and frame_owner == "B" and frame_survival == "B_frame_survived" and burden_closure.get("B") == "closed":
+            return {
